# Database connection — SmartFactoryDB
# Nguồn schema: E:\ysData\db\factory.sql
# Copy file này thành .env và chỉnh cho đúng SQL Server của bạn.

VITE_APP_NAME=SmartFactory

# Backend API (Node + mssql) — web Quản lý gọi REST qua biến này
VITE_API_URL=http://localhost:3001

# Dùng bởi API server (khi gắn backend). Vite chỉ expose biến VITE_*.
DB_SERVER=localhost
DB_DATABASE=SmartFactoryDB
DB_USER=sa
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Chuỗi kết nối đầy đủ (tùy chọn — ưu tiên hơn các biến rời nếu có)
# DATABASE_URL=Server=localhost;Database=SmartFactoryDB;User Id=sa;Password=***;TrustServerCertificate=True;
